{
  "name": "pr-rla-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "A read-only MCP server for pr-rla audits (stdio): it reads audits, draws and draw contexts, and never records a verdict",
  "type": "module",
  "bin": {
    "pr-rla-mcp": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 \"test/*.test.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "pr-rla": "file:../..",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
