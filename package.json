{
  "name": "pr-rla",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Risk-limiting audits for code changes that landed with no recorded human review",
  "type": "module",
  "bin": {
    "pr-rla": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/sdk/provider.d.ts",
      "default": "./dist/sdk/provider.js"
    },
    "./ledger": {
      "types": "./dist/sdk/ledger.d.ts",
      "default": "./dist/sdk/ledger.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./http": {
      "types": "./dist/sdk/http.d.ts",
      "default": "./dist/sdk/http.js"
    },
    "./api/read": {
      "types": "./dist/api/read/index.d.ts",
      "default": "./dist/api/read/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "asn1js": "4.0.0",
    "commander": "^15.0.0",
    "drand-client": "1.4.2",
    "pkijs": "4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
